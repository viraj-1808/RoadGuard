# RoadGuard AI Backend Configuration
# Copy this file to .env or backend/.env and adjust values as needed.

# Application Server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database Connection (SQLite default for local development)
DATABASE_URL=sqlite:///./roadguard.db

# CORS Configuration (JSON array of allowed origins for frontend development)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8080"]

# Evidence & Storage
EVIDENCE_STORAGE_DIR=./storage/evidence
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_IMAGE_TYPES=["image/jpeg", "image/png", "image/webp"]

# Model & Inference Settings
MODEL_NAME=YOLO11s
MODEL_CHECKPOINT_PATH=runs/detect/experiments/training/yol11s_dataset_v2_split_v2/weights/best.pt
DEFAULT_CONFIDENCE_THRESHOLD=0.25
DEFAULT_IOU_THRESHOLD=0.7
DEFAULT_IMAGE_SIZE=720
