# .gitignore for Pothole Detection & Reporting System

# --- Dataset and Large Media ---
# Do not commit datasets or large media files
datasets/
dataset/
data/
images/
videos/
*.jpg
*.jpeg
*.png
*.mp4
*.avi
*.mov
*.mkv
*.zip
*.tar
*.tar.gz

# --- Model Artifacts ---
# Do not commit model checkpoints, weights, or large binary files
models/
checkpoints/
weights/
*.pt
*.pth
*.h5
*.pb
*.onnx
*.engine

# --- Experiment Output ---
# Do not commit experiment outputs, logs, or temporary files
experiments/output/
experiments/logs/
experiments/runs/
*.log
*.out
*.err

# --- Python ---
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints

# --- Node.js / JavaScript ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Build Output ---
# Compiled binaries
*.exe
*.dll
*.so
*.dylib

# Build directories
build/
target/
out/
dist/
bin/
obj/

# --- OS ---
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.TR-*
.nfs*

# --- Miscellaneous ---
# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Backup files
*~
*.bak
*.swp

# Editor backup files
*#
*#