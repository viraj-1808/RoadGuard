# RoadGuard AI Frontend Configuration
# Copy this file to .env or .env.local to configure your environment

# Base URL for the RoadGuard Backend API
# When left blank or if backend is unreachable, frontend gracefully falls back to mock demo data
VITE_API_BASE_URL=http://localhost:8000

# Optional: Default Confidence Threshold (0.0 to 1.0)
VITE_DEFAULT_CONFIDENCE_THRESHOLD=0.65

# Optional: Enable Demo Mode toggle by default (true/false)
VITE_ENABLE_DEMO_MODE=false
